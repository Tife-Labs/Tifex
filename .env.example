# ============================================
# TIFEX — ENVIRONMENT VARIABLE TEMPLATE
# ============================================
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
# NEVER commit `.env.local`. It's in .gitignore.
# On Vercel, set these in Project → Settings → Environment Variables.

# Contact email (plain — used in mailto + display)
CONTACT_EMAIL=your-email@example.com

# Full international phone number with + (used for display + tel: link)
CONTACT_PHONE=+10000000000

# Phone digits only, no + (used for wa.me and t.me links)
CONTACT_PHONE_DIGITS=10000000000
